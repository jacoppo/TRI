---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'TriCalculator - Calcola il tuo tempo di triathlon',
  description = 'Calcola gratis il tuo tempo stimato per Sprint, Olimpico, 70.3 e Ironman in base a watt, tempi di corsa e nuoto.',
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="TriCalculator" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PWA / iPhone home screen icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TriCalc" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="oo_xClPEWtCfaGLL0uASzLvL__0vptWjnfezGRQ7lS4" />

    <!-- Tema: applicato prima del render per evitare il flash -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>

    <!-- Google AdSense (via Partytown — non blocca il main thread) -->
    <script
      type="text/partytown"
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9090975380946777"
      crossorigin="anonymous"
    ></script>

  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="header-inner">
          <a href="/" class="logo">
            <span class="tri">TRI</span><span class="calculator">CALCULATOR</span>
          </a>
          <span class="tagline">Calcola il tuo tempo di gara</span>
          <button class="theme-toggle" id="theme-toggle" aria-label="Cambia tema" type="button">
            <!-- Sole: visibile in dark mode, clic → passa a light -->
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
            </svg>
            <!-- Luna: visibile in light mode, clic → passa a dark -->
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <span>© {new Date().getFullYear()} TriCalculator. Tutti i diritti riservati.</span>
          <nav style="display:flex; gap: 1.5rem;">
            <a href="/guida">Guida al Triathlon</a>
            <a href="/privacy-policy">Privacy Policy</a>
          </nav>
        </div>
      </div>
    </footer>

    <!-- Theme toggle -->
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>

    <!-- Cookie Consent GDPR -->
    <script>
      // Mostra cookie banner se l'utente non ha ancora scelto
      const consent = localStorage.getItem('cookie-consent');
      if (!consent) {
        const banner = document.getElementById('cookie-banner');
        if (banner) banner.style.display = 'flex';
      }

      document.getElementById('btn-accept')?.addEventListener('click', () => {
        localStorage.setItem('cookie-consent', 'accepted');
        const banner = document.getElementById('cookie-banner');
        if (banner) banner.style.display = 'none';
      });

      document.getElementById('btn-decline')?.addEventListener('click', () => {
        localStorage.setItem('cookie-consent', 'rejected');
        const banner = document.getElementById('cookie-banner');
        if (banner) banner.style.display = 'none';
      });
    </script>

    <!-- Cookie Banner HTML -->
    <div
      id="cookie-banner"
      class="cookie-banner"
      role="dialog"
      aria-label="Consenso cookie"
      style="display: none;"
    >
      <p class="cookie-text">
        Questo sito usa cookie di terze parti per mostrare annunci personalizzati tramite Google AdSense.
        <a href="/privacy-policy">Leggi la Privacy Policy</a>
      </p>
      <div class="cookie-actions">
        <button id="btn-decline" class="btn-decline">Rifiuta</button>
        <button id="btn-accept" class="btn-accept">Accetta</button>
      </div>
    </div>
  </body>
</html>
