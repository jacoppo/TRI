---
// Default values shown on first load (typical amateur triathlete)
const defaults = {
  weight: 72,
  swim400: '7:30',
  swim1500: '',
  bikeWatts20: 200,
  bikeWatts90: 175,
  bikeWatts180: '',
  run10k: '45:00',
  runHalf: '',
  dailyCalories: 2500,
};
---

<div class="dashboard-grid" id="calculator">

  <!-- ========================================
       INPUT COLUMN
       ======================================== -->
  <div class="input-column">

    <!-- Dati fisici -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Dati fisici
      </h2>
      <div class="form-group">
        <label for="input-weight">
          Peso corporeo <span class="unit">(kg)</span>
          <span class="tooltip-icon" data-tip="Inserisci il tuo peso in kg senza equipaggiamento">?</span>
        </label>
        <input
          type="number"
          id="input-weight"
          min="40" max="150" step="0.5"
          value={defaults.weight}
          placeholder="72"
        />
      </div>
    </div>

    <!-- Nuoto -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c.6.5 1.2 1 2.5 1C7 13 7 11 9.5 11s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/><path d="M2 17c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/><path d="M22 7 12 2 2 7"/></svg>
        Nuoto
      </h2>
      <div class="form-row">
        <div class="form-group">
          <label for="input-swim400">
            Tempo 400m
            <span class="tooltip-icon" data-tip="Il tuo tempo su 400m in vasca (crawl). Esempio: 7:30">?</span>
          </label>
          <input type="text" id="input-swim400" placeholder="07:30" value={defaults.swim400} />
        </div>
        <div class="form-group">
          <label for="input-swim1500">
            Tempo 1.500m <span class="optional">(opz.)</span>
            <span class="tooltip-icon" data-tip="Più preciso per distanze lunghe. Inserisci se disponibile. Esempio: 25:00">?</span>
          </label>
          <input type="text" id="input-swim1500" placeholder="25:00" value={defaults.swim1500} />
        </div>
      </div>
      <div class="form-group">
        <label for="input-swim-km">
          Volume settimanale <span class="unit">(km/sett)</span> <span class="optional">(opz.)</span>
          <span class="tooltip-icon" data-tip="Km totali nuotati a settimana in media. Usato per i consigli di allenamento personalizzati.">?</span>
        </label>
        <input type="number" id="input-swim-km" min="0" max="50" step="0.5" placeholder="es. 6" />
      </div>
    </div>

    <!-- Bicicletta -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
        Bicicletta
      </h2>
      <div class="form-row">
        <div class="form-group">
          <label for="input-watts20">
            Watt su 20km <span class="unit">(Sprint/Olimpico)</span>
            <span class="tooltip-icon" data-tip="Watt medi che riesci a sostenere per 20km in gara. Misurabile con un ciclocomputer con powermeter.">?</span>
          </label>
          <input type="number" id="input-watts20" min="50" max="500" step="5" value={defaults.bikeWatts20} placeholder="200" />
        </div>
        <div class="form-group">
          <label for="input-watts90">
            Watt su 90km <span class="unit">(Medio)</span>
            <span class="tooltip-icon" data-tip="Watt medi per 90km. Tipicamente 85-90% dei tuoi watt su 20km.">?</span>
          </label>
          <input type="number" id="input-watts90" min="50" max="450" step="5" value={defaults.bikeWatts90} placeholder="175" />
        </div>
      </div>
      <div class="form-group">
        <label for="input-watts180">
          Watt su 180km <span class="unit">(Full)</span> <span class="optional">(opz.)</span>
          <span class="tooltip-icon" data-tip="Watt medi per 180km. Se non inserito, viene stimato automaticamente come 88% dei watt su 90km.">?</span>
        </label>
        <input type="number" id="input-watts180" min="50" max="400" step="5" value={defaults.bikeWatts180} placeholder="Calcolato automaticamente" />
      </div>
      <div class="form-group">
        <label for="input-bike-hours">
          Volume settimanale <span class="unit">(ore/sett)</span> <span class="optional">(opz.)</span>
          <span class="tooltip-icon" data-tip="Ore totali in sella a settimana in media. Usato per i consigli di allenamento personalizzati.">?</span>
        </label>
        <input type="number" id="input-bike-hours" min="0" max="30" step="0.5" placeholder="es. 7" />
      </div>
    </div>

    <!-- Percorso Bici -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l4-8 4 4 3-6 4 9"/><path d="M3 21h18"/></svg>
        Percorso Bici <span class="optional" style="font-weight:400;text-transform:none;letter-spacing:0;">(opz.)</span>
      </h2>

      <!-- Tabs GPX / Manuale -->
      <div class="route-input-tabs">
        <button class="route-input-tab active" data-route-tab="gpx" type="button">Carica GPX</button>
        <button class="route-input-tab" data-route-tab="manual" type="button">Inserisci manualmente</button>
      </div>

      <!-- Tab GPX -->
      <div id="route-tab-gpx" class="route-tab-content">
        <div class="form-group">
          <label>File GPX del percorso bici
            <span class="tooltip-icon" data-tip="Esporta il file GPX da Strava, Garmin Connect, Komoot o qualsiasi dispositivo GPS. Il file viene letto solo nel tuo browser, non viene inviato a nessun server.">?</span>
          </label>
          <label for="input-gpx" class="file-input-label" id="file-input-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span id="file-label-text">Clicca per scegliere il file GPX</span>
          </label>
          <input type="file" id="input-gpx" accept=".gpx" style="display:none" />
        </div>
        <div id="gpx-stats" class="gpx-stats" style="display:none"></div>
        <p id="gpx-error" class="gpx-error" style="display:none">File non valido o senza traccia GPS. Assicurati sia un file .gpx con punti traccia.</p>
      </div>

      <!-- Tab Manuale -->
      <div id="route-tab-manual" class="route-tab-content" style="display:none">
        <div class="form-row">
          <div class="form-group">
            <label for="input-route-dist">Distanza <span class="unit">(km)</span></label>
            <input type="number" id="input-route-dist" min="1" max="300" step="0.1" placeholder="es. 90" />
          </div>
          <div class="form-group">
            <label for="input-route-elev">
              Dislivello + <span class="unit">(m)</span>
              <span class="tooltip-icon" data-tip="Dislivello positivo totale del percorso. Lo trovi su Strava, Garmin Connect o Komoot.">?</span>
            </label>
            <input type="number" id="input-route-elev" min="0" max="10000" step="10" placeholder="es. 1200" />
          </div>
        </div>
      </div>

      <button class="btn-clear-route" id="btn-clear-route" type="button" style="display:none">
        Rimuovi percorso
      </button>
    </div>

    <!-- Corsa -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4a1 1 0 1 0 2 0 1 1 0 0 0-2 0"/><path d="M7 21l3-6 2 2 2-3 4 4"/><path d="M5 12l2-5 3 2 2-4h4l1 3-3 2"/></svg>
        Corsa
      </h2>
      <div class="form-row">
        <div class="form-group">
          <label for="input-run10k">
            Miglior 10km <span class="unit">(gara)</span>
            <span class="tooltip-icon" data-tip="Il tuo miglior tempo sui 10km in una gara reale, non in allenamento. Esempio: 45:00">?</span>
          </label>
          <input type="text" id="input-run10k" placeholder="45:00" value={defaults.run10k} />
        </div>
        <div class="form-group">
          <label for="input-runhalf">
            Miglior mezza <span class="optional">(opz.)</span>
            <span class="tooltip-icon" data-tip="Il tuo miglior tempo in mezza maratona (hh:mm:ss). Usato come riferimento per distanze lunghe. Esempio: 1:45:00">?</span>
          </label>
          <input type="text" id="input-runhalf" placeholder="1:45:00" value={defaults.runHalf} />
        </div>
      </div>
      <div class="form-group">
        <label for="input-run-km">
          Volume settimanale <span class="unit">(km/sett)</span> <span class="optional">(opz.)</span>
          <span class="tooltip-icon" data-tip="Km totali di corsa a settimana in media. Usato per i consigli di allenamento personalizzati.">?</span>
        </label>
        <input type="number" id="input-run-km" min="0" max="200" step="1" placeholder="es. 40" />
      </div>
    </div>

    <!-- Nutrizione -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>
        Nutrizione Pre-Gara
      </h2>
      <div class="form-group">
        <label for="input-calories">
          Calorie medie giornaliere <span class="unit">(kcal)</span>
          <span class="tooltip-icon" data-tip="Le kcal che consumi mediamente in un giorno di allenamento normale. Usato per calcolare le calorie extra da assumere nelle 48h pre-gara.">?</span>
        </label>
        <input type="number" id="input-calories" min="1500" max="5000" step="50" value={defaults.dailyCalories} placeholder="2500" />
      </div>
    </div>

    <button class="btn-reset" id="btn-reset" type="button">Ripristina valori di esempio</button>

  </div><!-- end input-column -->

  <!-- ========================================
       OUTPUT COLUMN
       ======================================== -->
  <div class="output-column">

    <!-- Athlete level -->
    <div class="level-wrapper">
      <span class="level-label">Livello atleta stimato:</span>
      <span class="level-badge" id="athlete-level" data-level="">—</span>
    </div>

    <!-- Results table -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        Tempi Stimati
      </h2>
      <div class="table-wrapper">
        <table class="results-table">
          <thead>
            <tr>
              <th>Formato</th>
              <th style="color: var(--color-swim);">Nuoto</th>
              <th>T1</th>
              <th style="color: var(--color-bike);">Bici</th>
              <th>T2</th>
              <th style="color: var(--color-run);">Corsa</th>
              <th>Totale</th>
            </tr>
          </thead>
          <tbody>
            {[
              { key: 'sprint',  name: 'Sprint',     t1: '2:00', t2: '1:00' },
              { key: 'olympic', name: 'Olimpico',   t1: '2:00', t2: '1:00' },
              { key: 'half',    name: 'Medio 70.3', t1: '3:00', t2: '2:00' },
              { key: 'full',    name: 'Full IM',    t1: '5:00', t2: '3:00' },
            ].map((row) => (
              <tr>
                <td class="td-format">{row.name}</td>
                <td class="td-time" id={`r-${row.key}-swim`}>—</td>
                <td class="td-transition">{row.t1}</td>
                <td class="td-time" id={`r-${row.key}-bike`}>—</td>
                <td class="td-transition">{row.t2}</td>
                <td class="td-time" id={`r-${row.key}-run`}>—</td>
                <td class="td-total" id={`r-${row.key}-total`}>—</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Share button -->
    <div class="share-row">
      <button class="btn-share" id="btn-share" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        Condividi i tuoi tempi
      </button>
    </div>

    <!-- Share Modal -->
    <div id="share-modal" class="share-modal" role="dialog" aria-modal="true" style="display:none">
      <div class="share-modal-overlay" id="share-modal-overlay"></div>
      <div class="share-modal-box">
        <div class="share-modal-header">
          <span class="share-modal-title">Condividi i tuoi tempi</span>
          <button class="share-modal-close" id="share-modal-close" aria-label="Chiudi" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <!-- Preview card (stile Strava) -->
        <div class="share-preview" id="share-preview">
          <div class="share-preview-header">
            <span class="share-preview-logo"><span style="color:#E53E3E">TRI</span>CALCULATOR</span>
            <span class="share-preview-url">tricalculator.app</span>
          </div>
          <div class="share-preview-label">Tempi stimati di gara</div>
          <div class="share-preview-table" id="share-preview-table">
            <!-- populated by JS -->
          </div>
        </div>

        <!-- Social buttons -->
        <div class="share-socials-grid">
          <!-- WhatsApp -->
          <a class="share-social-btn" id="ss-whatsapp" target="_blank" rel="noopener" title="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.528 5.845L.057 23.625a.5.5 0 0 0 .618.618l5.78-1.471A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.882a9.866 9.866 0 0 1-5.031-1.375l-.361-.214-3.733.951.968-3.633-.235-.374A9.843 9.843 0 0 1 2.118 12C2.118 6.528 6.528 2.118 12 2.118S21.882 6.528 21.882 12 17.472 21.882 12 21.882z"/></svg>
            WhatsApp
          </a>
          <!-- Telegram -->
          <a class="share-social-btn" id="ss-telegram" target="_blank" rel="noopener" title="Telegram">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.04 14.605l-2.95-.924c-.64-.203-.652-.64.136-.954l11.5-4.433c.537-.194 1.006.131.833.927h-.665z"/></svg>
            Telegram
          </a>
          <!-- X / Twitter -->
          <a class="share-social-btn" id="ss-twitter" target="_blank" rel="noopener" title="X / Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X / Twitter
          </a>
          <!-- Facebook -->
          <a class="share-social-btn" id="ss-facebook" target="_blank" rel="noopener" title="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Facebook
          </a>
          <!-- LinkedIn -->
          <a class="share-social-btn" id="ss-linkedin" target="_blank" rel="noopener" title="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <!-- Strava -->
          <button class="share-social-btn" id="ss-strava" type="button" title="Strava">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.599h4.172L10.463 0l-7 13.828h4.169"/></svg>
            Strava
          </button>
          <!-- Instagram -->
          <button class="share-social-btn" id="ss-instagram" type="button" title="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            Instagram
          </button>
          <!-- TikTok -->
          <button class="share-social-btn" id="ss-tiktok" type="button" title="TikTok">
