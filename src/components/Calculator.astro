---
// Default values shown on first load (typical amateur triathlete)
const defaults = {
  weight: 72,
  swim400: '7:30',
  swim1500: '',
  bikeWatts20: 200,
  bikeWatts90: 175,
  bikeWatts180: '',
  run10k: '45:00',
  runHalf: '',
  dailyCalories: 2500,
};
---

<div class="dashboard-grid" id="calculator">

  <!-- ========================================
       INPUT COLUMN
       ======================================== -->
  <div class="input-column">

    <!-- Dati fisici -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Dati fisici
      </h2>
      <div class="form-group">
        <label for="input-weight">
          Peso corporeo <span class="unit">(kg)</span>
          <span class="tooltip-icon" data-tip="Inserisci il tuo peso in kg senza equipaggiamento">?</span>
        </label>
        <input
          type="number"
          id="input-weight"
          min="40" max="150" step="0.5"
          value={defaults.weight}
          placeholder="72"
        />
      </div>
    </div>

    <!-- Nuoto -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c.6.5 1.2 1 2.5 1C7 13 7 11 9.5 11s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/><path d="M2 17c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/><path d="M22 7 12 2 2 7"/></svg>
        Nuoto
      </h2>
      <div class="form-row">
        <div class="form-group">
          <label for="input-swim400">
            Tempo 400m
            <span class="tooltip-icon" data-tip="Il tuo tempo su 400m in vasca (crawl). Esempio: 7:30">?</span>
          </label>
          <input type="text" id="input-swim400" placeholder="07:30" value={defaults.swim400} />
        </div>
        <div class="form-group">
          <label for="input-swim1500">
            Tempo 1.500m <span class="optional">(opz.)</span>
            <span class="tooltip-icon" data-tip="Più preciso per distanze lunghe. Inserisci se disponibile. Esempio: 25:00">?</span>
          </label>
          <input type="text" id="input-swim1500" placeholder="25:00" value={defaults.swim1500} />
        </div>
      </div>
    </div>

    <!-- Bicicletta -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
        Bicicletta
      </h2>
      <div class="form-row">
        <div class="form-group">
          <label for="input-watts20">
            Watt su 20km <span class="unit">(Sprint/Olimpico)</span>
            <span class="tooltip-icon" data-tip="Watt medi che riesci a sostenere per 20km in gara. Misurabile con un ciclocomputer con powermeter.">?</span>
          </label>
          <input type="number" id="input-watts20" min="50" max="500" step="5" value={defaults.bikeWatts20} placeholder="200" />
        </div>
        <div class="form-group">
          <label for="input-watts90">
            Watt su 90km <span class="unit">(Medio)</span>
            <span class="tooltip-icon" data-tip="Watt medi per 90km. Tipicamente 85-90% dei tuoi watt su 20km.">?</span>
          </label>
          <input type="number" id="input-watts90" min="50" max="450" step="5" value={defaults.bikeWatts90} placeholder="175" />
        </div>
      </div>
      <div class="form-group">
        <label for="input-watts180">
          Watt su 180km <span class="unit">(Full)</span> <span class="optional">(opz.)</span>
          <span class="tooltip-icon" data-tip="Watt medi per 180km. Se non inserito, viene stimato automaticamente come 88% dei watt su 90km.">?</span>
        </label>
        <input type="number" id="input-watts180" min="50" max="400" step="5" value={defaults.bikeWatts180} placeholder="Calcolato automaticamente" />
      </div>
    </div>

    <!-- Percorso Bici -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l4-8 4 4 3-6 4 9"/><path d="M3 21h18"/></svg>
        Percorso Bici <span class="optional" style="font-weight:400;text-transform:none;letter-spacing:0;">(opz.)</span>
      </h2>

      <!-- Tabs GPX / Manuale -->
      <div class="route-input-tabs">
        <button class="route-input-tab active" data-route-tab="gpx" type="button">Carica GPX</button>
        <button class="route-input-tab" data-route-tab="manual" type="button">Inserisci manualmente</button>
      </div>

      <!-- Tab GPX -->
      <div id="route-tab-gpx" class="route-tab-content">
        <div class="form-group">
          <label>File GPX del percorso bici
            <span class="tooltip-icon" data-tip="Esporta il file GPX da Strava, Garmin Connect, Komoot o qualsiasi dispositivo GPS. Il file viene letto solo nel tuo browser, non viene inviato a nessun server.">?</span>
          </label>
          <label for="input-gpx" class="file-input-label" id="file-input-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span id="file-label-text">Clicca per scegliere il file GPX</span>
          </label>
          <input type="file" id="input-gpx" accept=".gpx" style="display:none" />
        </div>
        <div id="gpx-stats" class="gpx-stats" style="display:none"></div>
        <p id="gpx-error" class="gpx-error" style="display:none">File non valido o senza traccia GPS. Assicurati sia un file .gpx con punti traccia.</p>
      </div>

      <!-- Tab Manuale -->
      <div id="route-tab-manual" class="route-tab-content" style="display:none">
        <div class="form-row">
          <div class="form-group">
            <label for="input-route-dist">Distanza <span class="unit">(km)</span></label>
            <input type="number" id="input-route-dist" min="1" max="300" step="0.1" placeholder="es. 90" />
          </div>
          <div class="form-group">
            <label for="input-route-elev">
              Dislivello + <span class="unit">(m)</span>
              <span class="tooltip-icon" data-tip="Dislivello positivo totale del percorso. Lo trovi su Strava, Garmin Connect o Komoot.">?</span>
            </label>
            <input type="number" id="input-route-elev" min="0" max="10000" step="10" placeholder="es. 1200" />
          </div>
        </div>
      </div>

      <button class="btn-clear-route" id="btn-clear-route" type="button" style="display:none">
        Rimuovi percorso
      </button>
    </div>

    <!-- Corsa -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4a1 1 0 1 0 2 0 1 1 0 0 0-2 0"/><path d="M7 21l3-6 2 2 2-3 4 4"/><path d="M5 12l2-5 3 2 2-4h4l1 3-3 2"/></svg>
        Corsa
      </h2>
      <div class="form-row">
        <div class="form-group">
          <label for="input-run10k">
            Miglior 10km <span class="unit">(gara)</span>
            <span class="tooltip-icon" data-tip="Il tuo miglior tempo sui 10km in una gara reale, non in allenamento. Esempio: 45:00">?</span>
          </label>
          <input type="text" id="input-run10k" placeholder="45:00" value={defaults.run10k} />
        </div>
        <div class="form-group">
          <label for="input-runhalf">
            Miglior mezza <span class="optional">(opz.)</span>
            <span class="tooltip-icon" data-tip="Il tuo miglior tempo in mezza maratona (hh:mm:ss). Usato come riferimento per distanze lunghe. Esempio: 1:45:00">?</span>
          </label>
          <input type="text" id="input-runhalf" placeholder="1:45:00" value={defaults.runHalf} />
        </div>
      </div>
    </div>

    <!-- Nutrizione -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>
        Nutrizione Pre-Gara
      </h2>
      <div class="form-group">
        <label for="input-calories">
          Calorie medie giornaliere <span class="unit">(kcal)</span>
          <span class="tooltip-icon" data-tip="Le kcal che consumi mediamente in un giorno di allenamento normale. Usato per calcolare le calorie extra da assumere nelle 48h pre-gara.">?</span>
        </label>
        <input type="number" id="input-calories" min="1500" max="5000" step="50" value={defaults.dailyCalories} placeholder="2500" />
      </div>
    </div>

    <button class="btn-reset" id="btn-reset" type="button">Ripristina valori di esempio</button>

  </div><!-- end input-column -->

  <!-- ========================================
       OUTPUT COLUMN
       ======================================== -->
  <div class="output-column">

    <!-- Athlete level -->
    <div class="level-wrapper">
      <span class="level-label">Livello atleta stimato:</span>
      <span class="level-badge" id="athlete-level" data-level="">—</span>
    </div>

    <!-- Results table -->
    <div class="card">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        Tempi Stimati
      </h2>
      <div class="table-wrapper">
        <table class="results-table">
          <thead>
            <tr>
              <th>Formato</th>
              <th style="color: var(--color-swim);">Nuoto</th>
              <th>T1</th>
              <th style="color: var(--color-bike);">Bici</th>
              <th>T2</th>
              <th style="color: var(--color-run);">Corsa</th>
              <th>Totale</th>
            </tr>
          </thead>
          <tbody>
            {[
              { key: 'sprint',  name: 'Sprint',     t1: '2:00', t2: '1:00' },
              { key: 'olympic', name: 'Olimpico',   t1: '2:00', t2: '1:00' },
              { key: 'half',    name: 'Medio 70.3', t1: '3:00', t2: '2:00' },
              { key: 'full',    name: 'Full IM',    t1: '5:00', t2: '3:00' },
            ].map((row) => (
              <tr>
                <td class="td-format">{row.name}</td>
                <td class="td-time" id={`r-${row.key}-swim`}>—</td>
                <td class="td-transition">{row.t1}</td>
                <td class="td-time" id={`r-${row.key}-bike`}>—</td>
                <td class="td-transition">{row.t2}</td>
                <td class="td-time" id={`r-${row.key}-run`}>—</td>
                <td class="td-total" id={`r-${row.key}-total`}>—</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Distance detail cards -->
    <div class="distance-cards-grid">
      {[
        { key: 'sprint',  name: 'Sprint',     distances: '750m · 20km · 5km'       },
        { key: 'olympic', name: 'Olimpico',   distances: '1.500m · 40km · 10km'    },
        { key: 'half',    name: 'Medio 70.3', distances: '1.900m · 90km · 21,1km'  },
        { key: 'full',    name: 'Full IM',    distances: '3.800m · 180km · 42,2km' },
      ].map((d) => (
        <div class="card distance-card">
          <h3 class="card-title">
            {d.name}
            <span class="distance-label">{d.distances}</span>
          </h3>
          <div class="progress-bar" id={`pb-${d.key}`} title="Nuoto · Bici · Corsa">
            <div class="progress-swim" id={`pb-${d.key}-swim`} style="width: 0%"></div>
            <div class="progress-bike" id={`pb-${d.key}-bike`} style="width: 0%"></div>
            <div class="progress-run"  id={`pb-${d.key}-run`}  style="width: 0%"></div>
          </div>
          <div class="stats-grid">
            <div class="stat">
              <span class="stat-label">Nuoto</span>
              <span class="stat-value swim" id={`s-${d.key}-swim`}>—</span>
            </div>
            <div class="stat">
              <span class="stat-label">Bici</span>
              <span class="stat-value bike" id={`s-${d.key}-bike`}>—</span>
            </div>
            <div class="stat">
              <span class="stat-label">Corsa</span>
              <span class="stat-value run" id={`s-${d.key}-run`}>—</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Route result card (visibile solo quando c'è un percorso) -->
    <div class="card mt-2 route-result-card" id="route-result-card" style="display:none">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l4-8 4 4 3-6 4 9"/><path d="M3 21h18"/></svg>
        Il tuo percorso bici
      </h2>
      <div class="route-result-meta">
        <div class="route-stat-pill">
          <span class="route-stat-pill-label">Distanza</span>
          <span class="route-stat-pill-value" id="rr-distance">—</span>
        </div>
        <div class="route-stat-pill">
          <span class="route-stat-pill-label">Dislivello +</span>
          <span class="route-stat-pill-value" id="rr-elevation">—</span>
        </div>
        <div class="route-stat-pill">
          <span class="route-stat-pill-label">Pendenza eff.</span>
          <span class="route-stat-pill-value" id="rr-gradient">—</span>
        </div>
      </div>
      <div class="route-result-main">
        <div class="route-result-item">
          <span class="route-result-label">Velocità media stimata</span>
          <span class="route-result-value bike" id="rr-speed">—</span>
        </div>
        <div class="route-result-item">
          <span class="route-result-label">Tempo stimato percorso</span>
          <span class="route-result-value primary" id="rr-time">—</span>
        </div>
        <div class="route-result-item">
          <span class="route-result-label">Watt utilizzati</span>
          <span class="route-result-value" id="rr-watts">—</span>
        </div>
      </div>
      <p class="route-result-note">
        Calcolo basato sui watt inseriti per la distanza del percorso, con correzione aerodinamica del dislivello positivo.
        Non considera vento, superficie stradale o variazioni di pendenza.
      </p>
    </div>

    <!-- Nutrition card -->
    <div class="card mt-2">
      <h2 class="card-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/><path d="M12 6v6l4 2"/></svg>
        Carb Loading Pre-Gara
      </h2>

      <!-- Selettore distanza -->
      <div class="nutrition-distance-selector">
        <span class="section-title">Seleziona la tua distanza di gara</span>
        <div class="nutrition-tabs">
          {[
            { key: 'sprint',  label: 'Sprint'  },
            { key: 'olympic', label: 'Olimpico'},
            { key: 'half',    label: '70.3'    },
            { key: 'full',    label: 'Full IM' },
          ].map((d) => (
            <button
              class={`nutrition-tab ${d.key === 'olympic' ? 'active' : ''}`}
              data-distance={d.key}
              type="button"
            >
              {d.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Tabella 48h / 24h -->
      <div class="nutrition-timeline">
        <!-- 48h prima -->
        <div class="nutrition-day">
          <div class="nutrition-day-header">
            <span class="nutrition-day-label">48h prima</span>
            <span class="nutrition-day-sub">2 giorni prima della gara</span>
          </div>
          <div class="nutrition-day-values">
            <div class="nutrition-item">
              <div class="nutrition-item-label">Carboidrati</div>
              <div class="nutrition-item-value">
                <span id="n-48h-cho">—</span><span class="nutrition-item-unit">g</span>
              </div>
            </div>
            <div class="nutrition-item">
              <div class="nutrition-item-label">Kcal da CHO</div>
              <div class="nutrition-item-value">
                <span id="n-48h-kcal">—</span><span class="nutrition-item-unit">kcal</span>
              </div>
            </div>
            <div class="nutrition-item nutrition-item-extra">
              <div class="nutrition-item-label">Kcal extra vs media</div>
              <div class="nutrition-item-value">
                <span id="n-48h-extra">—</span><span class="nutrition-item-unit">kcal</span>
              </div>
            </div>
          </div>
        </div>

        <div class="nutrition-divider"></div>

        <!-- 24h prima -->
        <div class="nutrition-day nutrition-day-highlight">
          <div class="nutrition-day-header">
            <span class="nutrition-day-label">24h prima</span>
            <span class="nutrition-day-sub">Il giorno prima della gara</span>
          </div>
          <div class="nutrition-day-values">
            <div class="nutrition-item">
              <div class="nutrition-item-label">Carboidrati</div>
              <div class="nutrition-item-value">
                <span id="n-24h-cho">—</span><span class="nutrition-item-unit">g</span>
              </div>
            </div>
            <div class="nutrition-item">
              <div class="nutrition-item-label">Kcal da CHO</div>
              <div class="nutrition-item-value">
                <span id="n-24h-kcal">—</span><span class="nutrition-item-unit">kcal</span>
              </div>
            </div>
            <div class="nutrition-item nutrition-item-extra">
              <div class="nutrition-item-label">Kcal extra vs media</div>
              <div class="nutrition-item-value">
                <span id="n-24h-extra">—</span><span class="nutrition-item-unit">kcal</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="nutrition-note" id="n-note">
        Seleziona la distanza per vedere il protocollo consigliato.
      </div>
    </div>

  </div><!-- end output-column -->
</div><!-- end dashboard-grid -->

<script>
  import { calcAllDistances, calcNutrition, calcAthleteLevel, calcRouteResult } from '../utils/calculator';
  import type { RouteData } from '../utils/calculator';
  import { parseTimeToSeconds, formatSpeed, formatPace, formatSwimPace } from '../utils/formatters';

  // ── Haversine distance (per GPX parsing) ─────────────────
  function haversineDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371000;
    const toRad = (d: number) => d * Math.PI / 180;
    const dLat = toRad(lat2 - lat1);
    const dLon = toRad(lon2 - lon1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // ── GPX parser (client-side, nessun server) ───────────────
  function parseGPX(text: string): RouteData | null {
    try {
      const parser = new DOMParser();
      const xml = parser.parseFromString(text, 'text/xml');
      if (xml.querySelector('parsererror')) return null;

      const trackpoints = Array.from(xml.querySelectorAll('trkpt'));
      if (trackpoints.length < 2) return null;

      let distanceM = 0;
      let elevationGainM = 0;
      let elevationLossM = 0;
      let prevLat: number | null = null;
      let prevLon: number | null = null;
      let prevEle: number | null = null;

      for (const pt of trackpoints) {
        const lat = parseFloat(pt.getAttribute('lat') ?? '0');
        const lon = parseFloat(pt.getAttribute('lon') ?? '0');
        const eleEl = pt.querySelector('ele');
        const ele = eleEl ? parseFloat(eleEl.textContent ?? '0') : null;

        if (prevLat !== null && prevLon !== null) {
          distanceM += haversineDistance(prevLat, prevLon, lat, lon);
        }
        if (ele !== null && prevEle !== null) {
          const diff = ele - prevEle;
          if (diff > 1)       elevationGainM += diff;       // filtra rumore < 1m
          else if (diff < -1) elevationLossM += Math.abs(diff);
        }
        prevLat = lat;
        prevLon = lon;
        if (ele !== null) prevEle = ele;
      }

      if (distanceM < 100) return null; // traccia troppo corta

      const nameEl = xml.querySelector('trk > name, metadata > name');
      return {
        distanceM,
        elevationGainM,
        elevationLossM,
        source: 'gpx',
        name: nameEl?.textContent?.trim() || undefined,
      };
    } catch {
      return null;
    }
  }

  // ── Route state ───────────────────────────────────────────
  let currentRoute: RouteData | null = null;

  // ── DOM helpers ──────────────────────────────────────────
  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function setWidth(id: string, pct: number) {
    const el = document.getElementById(id) as HTMLElement | null;
    if (el) el.style.width = `${Math.max(0, Math.min(100, pct))}%`;
  }

  // ── Read form data ────────────────────────────────────────
  function getInputNum(id: string): number | null {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el || el.value.trim() === '') return null;
    const v = parseFloat(el.value);
    return isNaN(v) ? null : v;
  }

  function getInputTime(id: string): number | null {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return null;
    return parseTimeToSeconds(el.value);
  }

  function parseFormData() {
    const weight = getInputNum('input-weight') ?? 72;
    return {
      weightKg: weight,
      swim400Time:  getInputTime('input-swim400') ?? undefined,
      swim1500Time: getInputTime('input-swim1500') ?? undefined,
      bikeWatts20:  getInputNum('input-watts20') ?? 0,
      bikeWatts90:  getInputNum('input-watts90') ?? undefined,
      bikeWatts180: getInputNum('input-watts180') ?? undefined,
      run10kTime:   getInputTime('input-run10k') ?? undefined,
      runHalfTime:  getInputTime('input-runhalf') ?? undefined,
      dailyCalories: getInputNum('input-calories') ?? 2500,
    };
  }

  // ── Update UI ─────────────────────────────────────────────
  function updateUI() {
    const data = parseFormData();
    const results = calcAllDistances(data);
    const level = calcAthleteLevel(data);

    // Athlete level badge
    const badge = document.getElementById('athlete-level');
    if (badge) {
      badge.textContent = level.overall;
      badge.setAttribute('data-level', level.overall);
    }

    // Results table + distance cards
    results.forEach((r) => {
      const k = r.key;

      // Table cells
      setText(`r-${k}-swim`,  r.swim?.displayTime ?? '—');
      setText(`r-${k}-bike`,  r.bike?.displayTime ?? '—');
      setText(`r-${k}-run`,   r.run?.displayTime  ?? '—');
      setText(`r-${k}-total`, r.totalDisplay);

      // Progress bars
      if (r.swim && r.bike && r.run && r.totalSec) {
        const swimPct = (r.swim.seconds / r.totalSec) * 100;
        const bikePct = (r.bike.seconds / r.totalSec) * 100;
        const runPct  = (r.run.seconds  / r.totalSec) * 100;
        setWidth(`pb-${k}-swim`, swimPct);
        setWidth(`pb-${k}-bike`, bikePct);
        setWidth(`pb-${k}-run`,  runPct);
      } else {
        setWidth(`pb-${k}-swim`, 0);
        setWidth(`pb-${k}-bike`, 0);
        setWidth(`pb-${k}-run`,  0);
      }

      // Stat values
      setText(`s-${k}-swim`, r.swim?.paceSecPer100m ? formatSwimPace(r.swim.paceSecPer100m) : '—');
      setText(`s-${k}-bike`, r.bike?.speedKmh       ? formatSpeed(r.bike.speedKmh)           : '—');
      setText(`s-${k}-run`,  r.run?.paceSecPerKm    ? formatPace(r.run.paceSecPerKm)          : '—');
    });

    // Route result
    const routeCard = document.getElementById('route-result-card');
    if (currentRoute && currentRoute.distanceM > 0) {
      const routeResult = calcRouteResult(data, currentRoute);
      if (routeResult && routeCard) {
        routeCard.style.display = 'block';
        setText('rr-distance', `${(currentRoute.distanceM / 1000).toFixed(1)} km`);
        setText('rr-elevation', `${Math.round(currentRoute.elevationGainM)} m`);
        const grad = (currentRoute.elevationGainM / currentRoute.distanceM * 100);
        setText('rr-gradient', `${grad.toFixed(1)}%`);
        setText('rr-speed', formatSpeed(routeResult.speedKmh ?? 0));
        setText('rr-time', routeResult.displayTime);
        // show watts used
        const distM = currentRoute.distanceM;
        let wattsUsed = data.bikeWatts20;
        if (distM > 30000) wattsUsed = data.bikeWatts90 ?? data.bikeWatts20 * 0.875;
        if (distM > 120000) wattsUsed = data.bikeWatts180 ?? (data.bikeWatts90 ?? data.bikeWatts20 * 0.875) * 0.88;
        setText('rr-watts', `${Math.round(wattsUsed)} W`);
      }
    } else {
      if (routeCard) routeCard.style.display = 'none';
    }

    // Nutrition
    const nutrition = calcNutrition(data, selectedDistance);
    setText('n-48h-cho',   String(nutrition.day48h.choGrams));
    setText('n-48h-kcal',  String(nutrition.day48h.choKcal));
    setText('n-48h-extra', nutrition.day48h.extraKcal > 0 ? `+${nutrition.day48h.extraKcal}` : '0');
    setText('n-24h-cho',   String(nutrition.day24h.choGrams));
    setText('n-24h-kcal',  String(nutrition.day24h.choKcal));
    setText('n-24h-extra', nutrition.day24h.extraKcal > 0 ? `+${nutrition.day24h.extraKcal}` : '0');
    setText('n-note',      nutrition.note);
  }

  // ── Route input tab switching ─────────────────────────────
  document.querySelectorAll('.route-input-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.route-input-tab').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = (btn as HTMLElement).dataset['routeTab'];
      document.getElementById('route-tab-gpx')!.style.display   = tab === 'gpx'    ? 'block' : 'none';
      document.getElementById('route-tab-manual')!.style.display = tab === 'manual' ? 'block' : 'none';
      // Reset route when switching tabs
      currentRoute = null;
      document.getElementById('gpx-stats')!.style.display = 'none';
      document.getElementById('gpx-error')!.style.display = 'none';
      document.getElementById('btn-clear-route')!.style.display = 'none';
      setText('file-label-text', 'Clicca per scegliere il file GPX');
      updateUI();
    });
  });

  // ── GPX file upload ───────────────────────────────────────
  function showGpxStats(route: RouteData) {
    const el = document.getElementById('gpx-stats');
    if (!el) return;
    const distKm = (route.distanceM / 1000).toFixed(1);
    el.innerHTML = `
      <div class="gpx-stat-row">
        <span class="gpx-stat"><strong>${distKm} km</strong><em>Distanza</em></span>
        <span class="gpx-stat"><strong>+${Math.round(route.elevationGainM)} m</strong><em>Dislivello +</em></span>
        <span class="gpx-stat"><strong>-${Math.round(route.elevationLossM)} m</strong><em>Dislivello -</em></span>
      </div>
      ${route.name ? `<p class="gpx-name">${route.name}</p>` : ''}
    `;
    el.style.display = 'block';
  }

  document.getElementById('input-gpx')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    const errEl = document.getElementById('gpx-error')!;
    const statsEl = document.getElementById('gpx-stats')!;
    if (!file) return;

    setText('file-label-text', file.name);
    errEl.style.display = 'none';
    statsEl.style.display = 'none';

    const reader = new FileReader();
    reader.onload = (ev) => {
      const text = ev.target?.result as string;
      const route = parseGPX(text);
      if (!route) {
        errEl.style.display = 'block';
        currentRoute = null;
        document.getElementById('btn-clear-route')!.style.display = 'none';
      } else {
        currentRoute = route;
        showGpxStats(route);
        document.getElementById('btn-clear-route')!.style.display = 'block';
      }
      updateUI();
    };
    reader.readAsText(file);
  });

  // ── Manual route input ────────────────────────────────────
  function readManualRoute(): RouteData | null {
    const distEl  = document.getElementById('input-route-dist')  as HTMLInputElement | null;
    const elevEl  = document.getElementById('input-route-elev')  as HTMLInputElement | null;
    const dist  = distEl?.value  ? parseFloat(distEl.value)  : null;
    const elev  = elevEl?.value  ? parseFloat(elevEl.value)  : null;
    if (!dist || dist <= 0) return null;
    return {
      distanceM:     dist * 1000,
      elevationGainM: elev ?? 0,
      elevationLossM: 0,
      source: 'manual',
    };
  }

  ['input-route-dist', 'input-route-elev'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', () => {
      const route = readManualRoute();
      currentRoute = route;
      const clearBtn = document.getElementById('btn-clear-route')!;
      clearBtn.style.display = route ? 'block' : 'none';
      updateUI();
    });
  });

  // ── Clear route button ────────────────────────────────────
  document.getElementById('btn-clear-route')?.addEventListener('click', () => {
    currentRoute = null;
    (document.getElementById('input-gpx')    as HTMLInputElement).value = '';
    (document.getElementById('input-route-dist') as HTMLInputElement).value = '';
    (document.getElementById('input-route-elev') as HTMLInputElement).value = '';
    document.getElementById('gpx-stats')!.style.display = 'none';
    document.getElementById('gpx-error')!.style.display = 'none';
    document.getElementById('btn-clear-route')!.style.display = 'none';
    setText('file-label-text', 'Clicca per scegliere il file GPX');
    updateUI();
  });

  // ── Nutrition distance selector ───────────────────────────
  let selectedDistance = 'olympic';

  document.querySelectorAll('.nutrition-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.nutrition-tab').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedDistance = (btn as HTMLElement).dataset['distance'] ?? 'olympic';
      updateUI();
    });
  });

  // ── Event listeners ───────────────────────────────────────
  const inputIds = [
    'input-weight', 'input-swim400', 'input-swim1500',
    'input-watts20', 'input-watts90', 'input-watts180',
    'input-run10k', 'input-runhalf', 'input-calories',
  ];

  inputIds.forEach((id) => {
    document.getElementById(id)?.addEventListener('input', updateUI);
  });

  // Reset button
  document.getElementById('btn-reset')?.addEventListener('click', () => {
    const setVal = (id: string, v: string | number) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = String(v);
    };
    setVal('input-weight',   72);
    setVal('input-swim400',  '7:30');
    setVal('input-swim1500', '');
    setVal('input-watts20',  200);
    setVal('input-watts90',  175);
    setVal('input-watts180', '');
    setVal('input-run10k',   '45:00');
    setVal('input-runhalf',  '');
    setVal('input-calories', 2500);
    updateUI();
  });

  // Initial calculation on page load
  updateUI();
</script>
