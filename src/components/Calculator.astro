    const plan = TAPER_DATA[key];
    if (!plan) return;
    const content = document.getElementById('taper-content');
    if (!content) return;

    const phasesHtml = plan.phases.map((phase, i) => `
      <div class="taper-phase">
        <div class="taper-phase-header">
          <span class="taper-phase-dot taper-dot-${i + 1}"></span>
          <span class="taper-phase-label">${phase.label}</span>
          <span class="taper-phase-badge">Volume ${phase.reduction}</span>
        </div>
        <ul class="taper-tips">
          ${phase.tips.map(t => `<li>${t}</li>`).join('')}
        </ul>
      </div>
    `).join('');

    const morningHtml = plan.raceMorning.map(t => `<li>${t}</li>`).join('');

    content.innerHTML = `
      <div class="taper-overview">${plan.overview}</div>
      <div class="taper-duration-badge">Durata taper: <strong>${plan.duration}</strong></div>
