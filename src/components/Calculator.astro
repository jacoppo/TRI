      const tab = (btn as HTMLElement).dataset['coachingTab'];
      const panel = document.getElementById(`cpanel-${tab}`);
      if (panel) panel.style.display = 'block';
    });
  });

  // ── Share modal ───────────────────────────────────────────
  function buildShareTexts() {
    const data = parseFormData();
    const results = calcAllDistances(data, currentRoute).filter(r => r.totalSec !== null);
    if (!results.length) return null;

    // Preview table HTML
    const tableHtml = results.map(r => `
      <div class="sp-row">
        <span class="sp-name">${r.name}</span>
        <span class="sp-swim">🏊 ${r.swim?.displayTime ?? '—'}</span>
        <span class="sp-bike">🚴 ${r.bike?.displayTime ?? '—'}</span>
        <span class="sp-run">🏃 ${r.run?.displayTime ?? '—'}</span>
        <span class="sp-total">${r.totalDisplay}</span>
      </div>`).join('');

    // Plain text (WhatsApp, Telegram, copy)
    const lines = results.map(r =>
      `${r.name}: 🏊 ${r.swim?.displayTime ?? '—'} | 🚴 ${r.bike?.displayTime ?? '—'} | 🏃 ${r.run?.displayTime ?? '—'} → ${r.totalDisplay}`
    ).join('\n');
    const plain = `I miei tempi stimati al triathlon:\n\n${lines}\n\nCalcolato con TriCalculator → tricalculator.app`;

    // Twitter (short)
    const totals = results.map(r => `${r.name}: ${r.totalDisplay}`).join(' | ');
    const tweet = `I miei tempi stimati al triathlon 🏊🚴🏃\n${totals}\n\nCalcolato su tricalculator.app #triathlon #triathlete #ironman`;

    // Strava
    const stravaLines = results.map(r =>
      `${r.name}: 🏊 ${r.swim?.displayTime ?? '—'} | 🚴 ${r.bike?.displayTime ?? '—'} | 🏃 ${r.run?.displayTime ?? '—'} | ⏱ ${r.totalDisplay}`
    ).join('\n');
    const strava = `📊 Analisi tempi pre-gara\n\n${stravaLines}\n\nCalcolato con TriCalculator → tricalculator.app\n\n#triathlon #ironman70dot3 #triathlete #trilife #training`;

    // Instagram/TikTok
    const igTk = `${plain}\n\n#triathlon #triathlete #ironman #ironman703 #triathlontraining #trilife #swimming #cycling #running`;

    return { tableHtml, plain, tweet, strava, igTk };
  }

  function showFeedback(msg: string) {
    const el = document.getElementById('share-feedback');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 2500);
  }

  function copyAndFeedback(text: string, msg: string) {
    navigator.clipboard.writeText(text).then(() => showFeedback(msg)).catch(() => {});
  }

  function openModal() {
    const texts = buildShareTexts();
    const modal = document.getElementById('share-modal');
    if (!modal) return;
    if (!texts) { showFeedback('Inserisci almeno un tempo per condividere.'); return; }

    // Populate preview
    const table = document.getElementById('share-preview-table');
    if (table) table.innerHTML = texts.tableHtml;

    const url = 'https://tricalculator.app';
    const enc = encodeURIComponent;

    // Wire up links
    const wa = document.getElementById('ss-whatsapp') as HTMLAnchorElement;
    if (wa) wa.href = `https://wa.me/?text=${enc(texts.plain)}`;

    const tg = document.getElementById('ss-telegram') as HTMLAnchorElement;
    if (tg) tg.href = `https://t.me/share/url?url=${enc(url)}&text=${enc(texts.plain)}`;

    const tw = document.getElementById('ss-twitter') as HTMLAnchorElement;
    if (tw) tw.href = `https://twitter.com/intent/tweet?text=${enc(texts.tweet)}`;

    const fb = document.getElementById('ss-facebook') as HTMLAnchorElement;
    if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}&quote=${enc(texts.plain)}`;

    const li = document.getElementById('ss-linkedin') as HTMLAnchorElement;
    if (li) li.href = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`;

    document.getElementById('ss-strava')?.addEventListener('click', () => {
      copyAndFeedback(texts.strava, '✓ Testo copiato! Aprendo Strava…');
      setTimeout(() => window.open('https://www.strava.com/athlete/posts', '_blank'), 600);
    }, { once: true });

    document.getElementById('ss-instagram')?.addEventListener('click', () => {
      copyAndFeedback(texts.igTk, '✓ Testo copiato! Aprendo Instagram…');
      setTimeout(() => window.open('https://www.instagram.com/', '_blank'), 600);
    }, { once: true });

    document.getElementById('ss-tiktok')?.addEventListener('click', () => {
      copyAndFeedback(texts.igTk, '✓ Testo copiato! Aprendo TikTok…');
      setTimeout(() => window.open('https://www.tiktok.com/upload', '_blank'), 600);
    }, { once: true });

    document.getElementById('ss-copy')?.addEventListener('click', () => {
      copyAndFeedback(texts.plain, '✓ Testo copiato negli appunti!');
    }, { once: true });

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('share-modal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  // ── Generate share card (Canvas PNG) ─────────────────────
  function generateCard() {
    const data = parseFormData();
    const results = calcAllDistances(data, currentRoute).filter(r => r.totalSec !== null);
    if (!results.length) { showFeedback('Inserisci almeno un tempo per generare la card.'); return; }

    const size = 1080;
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    const c = canvas.getContext('2d')!;

    const bg      = '#0F0F0F';
    const surface = '#1A1A1A';
    const border  = '#2E2E2E';
    const red     = '#E53E3E';
    const textPri = '#F5F5F5';
    const textSec = '#A0A0A0';
    const swim    = '#38A169';
    const bike    = '#D69E2E';
    const run     = '#3182CE';

    // Background
    c.fillStyle = bg;
    c.fillRect(0, 0, size, size);

    // Top red bar
    c.fillStyle = red;
    c.fillRect(0, 0, size, 10);

    // Logo
    c.font = 'bold 58px Inter, system-ui, sans-serif';
    c.fillStyle = red;
    c.fillText('TRI', 80, 115);
    const triW = c.measureText('TRI').width;
    c.fillStyle = textPri;
    c.fillText('CALCULATOR', 80 + triW, 115);

    // Tagline
    c.font = '500 26px Inter, system-ui, sans-serif';
    c.fillStyle = textSec;
    c.fillText('I MIEI TEMPI STIMATI DI GARA', 80, 162);

    // Divider
    c.fillStyle = border;
    c.fillRect(80, 188, size - 160, 2);

    // Results rows
    const rowH = results.length <= 2 ? 200 : 170;
    let y = 240;

    results.forEach((r, i) => {
      // Row bg alternating
      if (i % 2 === 0) {
        c.fillStyle = surface;
        const pad = 60;
        c.beginPath();
        const rr = 12;
        c.roundRect(pad, y - 28, size - pad * 2, rowH - 16, rr);
        c.fill();
      }

      // Distance name
      c.font = 'bold 40px Inter, system-ui, sans-serif';
      c.fillStyle = textPri;
      c.fillText(r.name, 100, y + 14);

      // Swim / Bike / Run labels + times
      const labelY = y + 62;
      c.font = '500 28px Inter, system-ui, sans-serif';

      c.fillStyle = swim;
      c.fillText('Nuoto  ' + (r.swim?.displayTime ?? '—'), 100, labelY);

      c.fillStyle = bike;
      c.fillText('Bici  ' + (r.bike?.displayTime ?? '—'), 380, labelY);

      c.fillStyle = run;
      c.fillText('Corsa  ' + (r.run?.displayTime ?? '—'), 660, labelY);

      // Total (right-aligned, large)
      c.font = 'bold 46px Inter, system-ui, sans-serif';
      c.fillStyle = red;
      const totalW = c.measureText(r.totalDisplay).width;
      c.fillText(r.totalDisplay, size - 100 - totalW, y + 14);

      y += rowH;
    });

    // Bottom divider
    c.fillStyle = border;
    c.fillRect(80, size - 100, size - 160, 2);

    // URL
    c.font = '500 30px Inter, system-ui, sans-serif';
    c.fillStyle = textSec;
    c.fillText('tricalculator.app', 80, size - 50);

    // Bottom red bar
    c.fillStyle = red;
    c.fillRect(0, size - 10, size, 10);

    // Download
    const link = document.createElement('a');
    link.download = 'tricalculator-tempi.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
    showFeedback('✓ Card scaricata! Postala su TikTok o Instagram.');
  }

  document.getElementById('btn-generate-card')?.addEventListener('click', generateCard);

  document.getElementById('btn-share')?.addEventListener('click', openModal);
  document.getElementById('share-modal-close')?.addEventListener('click', closeModal);
  document.getElementById('share-modal-overlay')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // ── Zones tabs ────────────────────────────────────────────
  document.querySelectorAll('.zones-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.zones-tab').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = (btn as HTMLElement).dataset['zonesTab'];
      document.getElementById('zones-panel-bike')!.style.display = tab === 'bike' ? 'block' : 'none';
      document.getElementById('zones-panel-run')!.style.display  = tab === 'run'  ? 'block' : 'none';
    });
  });

  // ── Event listeners ───────────────────────────────────────
  const inputIds = [
    'input-weight', 'input-swim400', 'input-swim1500',
    'input-swim-km', 'input-watts20', 'input-watts90', 'input-watts180',
    'input-bike-hours', 'input-run10k', 'input-runhalf', 'input-run-km',
    'input-calories',
  ];

  inputIds.forEach((id) => {
    document.getElementById(id)?.addEventListener('input', () => {
      updateUI();
      // Aggiorna coaching in tempo reale solo se la sezione è aperta
      if (document.getElementById('coaching-section')?.style.display !== 'none') {
        updateCoaching();
      }
    });
  });

  // Reset button
  document.getElementById('btn-reset')?.addEventListener('click', () => {
    const setVal = (id: string, v: string | number) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = String(v);
    };
    setVal('input-weight',   72);
    setVal('input-swim400',  '7:30');
    setVal('input-swim1500', '');
    setVal('input-watts20',  200);
    setVal('input-watts90',  175);
    setVal('input-watts180', '');
    setVal('input-run10k',   '45:00');
    setVal('input-runhalf',  '');
    setVal('input-calories', 2500);
    updateUI();
  });

  // Initial calculation on page load
  updateUI();
</script>
